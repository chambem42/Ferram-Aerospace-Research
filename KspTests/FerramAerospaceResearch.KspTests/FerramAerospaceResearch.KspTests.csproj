<Project Sdk="Microsoft.NET.Sdk">

    <!--
        FAR's in-game tests on stock KSP (some fly on AtmosphereAutopilot, some need B9 procedural wings; each skips without what it needs).
        [UITest] methods the KspTest harness runs in a KSP session; loaded by KSP, so net48, built against the install in
        KspDir (see ../Directory.Build.props). FerramAerospaceResearch.KspTests.Run runs them with dotnet test; FAR itself
        does not depend on this.
    -->
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>9</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <RootNamespace>FerramAerospaceResearch.KspTests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <PropertyGroup>
        <!-- the harness and these modules from the KspTest submodule, compile-time only: the runner deploys them -->
        <KspTestModules>AtmosphereAutopilot</KspTestModules>
    </PropertyGroup>

    <Import Project="$(KspTestRoot)/build/KspTest.FromSource.targets" />

</Project>

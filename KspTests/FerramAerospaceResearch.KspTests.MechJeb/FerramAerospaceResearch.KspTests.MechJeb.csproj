<Project Sdk="Microsoft.NET.Sdk">

    <!--
        FAR's in-game tests that fly on MechJeb: deployed only into installs with MechJeb.
        [UITest] methods the KspTest harness runs in a KSP session; loaded by KSP, so net48, built against the install in
        KspDir (see ../Directory.Build.props). FerramAerospaceResearch.KspTests.Run runs them with dotnet test; FAR itself
        does not depend on this.
    -->
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>9</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <RootNamespace>FerramAerospaceResearch.KspTests.MechJeb</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <!-- compile-time only: the harness is deployed into GameData by the runner -->
        <PackageReference Include="KspTest" Version="$(KspTestVersion)" />
        <PackageReference Include="KspTest.MechJeb" Version="$(KspTestVersion)" />
    </ItemGroup>

</Project>
